{
 "id": "look-check",
 "version": "0.1",
 "title": "Look check",
 "category": "Examples",
 "license": "GPL-2.0-or-later",
 "author": "Iced-Cream",
 "description": "A test for core-a4mk2 0.6's knob looks (core_knob_looks) on the Analog Four MKII. At the first tick after stock's first draw it groups stock's UI records by look and gives an own knob the look of each group's first id through a core_knob_looks entry, plus one knob with a ui callback's record and one with a range of 0..12. LOOK CHECK behind the AMP key shows four pairs (a stock id and its own knob, the same value and text), knob J choosing which. What core's UI record and range lookups answer for every own knob is in RAM after the magic LKA1, and a square at the bottom right says all of it matched.",
 "device": "analog-four-mk2",
 "os": "1.56",
 "sources": [
  "look.c"
 ],
 "subscribe": [
  {
   "event": "ev_tick",
   "fn": "lk_tick",
   "order": 60
  },
  {
   "event": "ev_draw",
   "fn": "lk_draw",
   "order": 60
  }
 ],
